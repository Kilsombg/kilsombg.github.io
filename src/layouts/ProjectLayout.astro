---
import BaseLayout from "./BaseLayout.astro";
import type { Project } from "../data/projects";

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} — Ivan Kamenov`} description={project.summary}>
	<article class="section case">
		<div class="container case-inner">
			<a class="back-link" href="/#projects">← Back to projects</a>

			<p class="case-status">{project.status}</p>
			<h1 class="case-title">{project.title}</h1>
			<p class="case-tagline text-dim">{project.tagline}</p>

			<div class="case-tags">
				{project.tags.map((tag) => <span class="tag">{tag}</span>)}
			</div>

			<div class="case-media">
				{
					project.image ? (
						<img src={project.image} alt={project.imageAlt} />
					) : (
						<div class="case-placeholder">
							<div class="case-placeholder-grid">
								{
									project.subGames?.map((g) => (
										<div class="case-placeholder-tile">
											<span class="tile-title">{g.title}</span>
											<span class="tile-genre">{g.genre}</span>
										</div>
									))
								}
							</div>
						</div>
					)
				}
			</div>

			<div class="case-links">
				{
					project.links.map((link, i) => (
						<a
							class={i === 0 ? "btn btn-primary" : "btn btn-ghost"}
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							{link.label} ↗
						</a>
					))
				}
			</div>

			<div class="case-body">
				<div class="case-section">
					<h2>Overview</h2>
					<p class="text-dim case-overview">{project.overview}</p>
				</div>

				<div class="case-section">
					<h2>Role</h2>
					<p class="text-dim">{project.role}</p>
				</div>

				<div class="case-section">
					<h2>Highlights</h2>
					<ul class="case-highlights">
						{project.highlights.map((h) => <li>{h}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.case-inner {
		max-width: 820px;
	}

	.back-link {
		display: inline-block;
		color: var(--text-dim);
		font-size: 0.9rem;
		margin-bottom: var(--space-3);
		transition: color 0.15s ease;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.case-status {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-faint);
	}

	.case-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-block: 0.3em 0.3em;
	}

	.case-tagline {
		font-size: 1.05rem;
		max-width: 60ch;
	}

	.case-overview {
		text-align: justify;
	}

	.case-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block: var(--space-2);
	}

	.case-media {
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--border);
		margin-block: var(--space-3);
		aspect-ratio: 16 / 9;
		background: var(--bg-elevated);
	}

	.case-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.case-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 60%), var(--bg-elevated-2);
		padding: var(--space-4);
	}

	.case-placeholder-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		gap: 0.75rem;
		width: 100%;
	}

	.case-placeholder-tile {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 0.75rem 0.9rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.tile-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.95rem;
	}

	.tile-genre {
		font-size: 0.78rem;
		color: var(--text-faint);
	}

	.case-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
	}

	.case-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.case-section h2 {
		font-size: 1.3rem;
		margin-bottom: 0.5em;
		color: var(--accent);
	}

	.case-highlights {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		color: var(--text-dim);
	}

	.case-highlights li {
		position: relative;
		padding-left: 1.3em;
	}

	.case-highlights li::before {
		content: "▸";
		position: absolute;
		left: 0;
		color: var(--accent);
	}
</style>
